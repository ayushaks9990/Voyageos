# Optional. The catalog planner works without keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional real hotel discovery (Google Places API New; billing required).
GOOGLE_PLACES_API_KEY=
# Optional flight offer search. Test results are explicitly labelled.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# Same-origin frontend needs no CORS setting.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=12
ENABLE_PUBLIC_ENRICHMENT=true
# Required in production. Use a long random value; Render generates it from render.yaml.
AUTH_SECRET=replace-with-a-long-random-secret
# Optional location for the SQLite account/trip database.
DATA_DIR=./data
# Keep false for http://localhost and true on HTTPS deployments.
COOKIE_SECURE=false
